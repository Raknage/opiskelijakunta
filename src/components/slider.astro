---
import { Image } from "astro:assets";

interface Props {
  size: number;
}

const items = [
  {
    src: "https://opiskelijakunta.net/wp-content/uploads/2024/06/2_85.png",
    alt: "Yhteistyökumppanit",
    href: "/",
  },
  {
    src: "https://opiskelijakunta.net/wp-content/uploads/2023/08/tok-logo-min.jpg",
    alt: "TOK",
    href: "https://tok.fi/s-etukortti/opiskelijalle",
  },
  {
    src: "https://opiskelijakunta.net/wp-content/uploads/2026/03/TS-logo.jpg",
    alt: "Turun Sanomat",
    href: "https://asiakaspalvelu.ts.fi/tilaa/opiskelija/",
  },
  {
    src: "https://opiskelijakunta.net/wp-content/uploads/2023/05/Unica_TUOnettisivut600x600-min.jpg",
    alt: "Unica",
    href: "https://www.unica.fi/ravintolat/",
  },
  {
    src: "https://opiskelijakunta.net/wp-content/uploads/2024/01/2_33.png",
    alt: "Panda Turva",
    href: "https://pandaturva.fi/",
  },
  {
    src: "https://opiskelijakunta.net/wp-content/uploads/2023/02/Nimeton-suunn.malli-16-min.jpg",
    alt: "Viking Line",
    href: "https://www.vikingline.fi/",
  },
];

const { size } = Astro.props;
---

<div>
  <section
    class="group no-scrollbar flex h-full w-full touch-pan-x overflow-x-auto py-10 select-none md:overflow-hidden">
    <div
      class="animate-infinite-scroll flex h-full min-w-full shrink-0 items-center justify-around group-hover:[animation-play-state:paused]">
      {
        items.map((item) => (
          <a
            href={item.href}
            class="shadow-tuo-xl/30 mx-4 flex h-full shrink-0 items-center rounded-2xl sm:mx-6">
            <Image
              height={size}
              width={size}
              decoding="async"
              src={item.src}
              alt={item.alt}
              class="h-full w-auto rounded-2xl object-contain"
            />
          </a>
        ))
      }
    </div>

    <div
      class="animate-infinite-scroll flex h-full min-w-full shrink-0 items-center justify-around group-hover:[animation-play-state:paused]"
      aria-hidden="true">
      {
        items.map((item) => (
          <a
            href={item.href}
            class="shadow-tuo-xl/30 mx-4 flex h-full shrink-0 items-center rounded-2xl sm:mx-6"
            tabindex="-1">
            <Image
              height={size}
              width={size}
              decoding="async"
              src={item.src}
              alt={item.alt}
              class="h-full w-auto rounded-2xl object-contain"
            />
          </a>
        ))
      }
    </div>
  </section>
</div>

<style>
  /* Utility to hide the scrollbar UI on mobile while maintaining native swipe/drag functionality */
  .no-scrollbar::-webkit-scrollbar {
    display: none;
  }
  .no-scrollbar {
    -ms-overflow-style: none;
    scrollbar-width: none;
  }
</style>
