---
import { Image } from "astro:assets";

interface Props {
  reverse?: boolean;
  title: string;
  img?: string;
  id?: string;
  alt?: string;
}

const {
  reverse = false,
  title,
  img = "https://opiskelijakunta.net/wp-content/uploads/2022/10/Nimeton-suunn.malli-9-min.jpg",
  id,
  alt = "",
} = Astro.props;
const rev = reverse ? "lg:flex-row-reverse" : "lg:flex-row";
---

<div id={id} class="bg-white py-10">
  <div class:list={["mx-5 flex flex-col items-center gap-8 py-4 lg:mx-20", rev]}>
    <Image
      src={img}
      alt={alt}
      class="rounded-tuo shadow-tuo-md w-full object-cover lg:w-1/2"
      loading="lazy"
      decoding="async"
      inferSize
    />
    <div class="w-full *:py-3 lg:w-1/2">
      <h2 class="">{title}</h2>
      <slot />
    </div>
  </div>
</div>
