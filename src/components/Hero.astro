---
const { title } = Astro.props;
---

<section
  class="bg-[url(https://opiskelijakunta.net/wp-content/uploads/2022/10/Nimeton-suunn.malli-12-min-1.jpg)] bg-cover bg-bottom pt-[20vh] pb-[12vh]">
  <div class="bg-tuo-blue/50 py-2.5 backdrop-blur-xs backdrop-grayscale-100">
    <h1 class="font-lato mx-auto w-8/10 text-center text-6xl font-extrabold uppercase">
      {title}
    </h1>
  </div>
</section>
