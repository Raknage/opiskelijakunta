---
import Portrait from "@/components/ui/Portrait.astro";
import type { People } from "@/lib/schemas";

interface Props {
  people: People;
}

const { people } = Astro.props;
---

<section class="mx-10 flex flex-row flex-wrap justify-center gap-x-10 gap-y-4 py-10 xl:mx-20">
  {
    Object.entries(people).map((person) => {
      return <Portrait person={person[1]} />;
    })
  }
</section>
