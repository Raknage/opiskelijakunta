---
import type { PageProps } from "@/schemas";

type Props = PageProps;
const props = Astro.props;
---

<nav class="hidden p-2 lg:block">
  <ul class="flex flex-wrap justify-center gap-7">
    {
      props.submenu?.map((anchor) => {
        return (
          <li>
            <a
              href={"id" in anchor ? `/opiskelijakunta/${anchor.id}` : anchor.url}
              target={"id" in anchor ? "_self" : "_blank"}
              aria-current="page"
              class="hover:text-tuo-dark-blue uppercase">
              {anchor.label}
            </a>
          </li>
        );
      })
    }
  </ul>
</nav>
