---
import { Image } from "astro:assets";
import Navigation from "@/components/ui/Navigation.astro";

// logo z-21, nav z-10, navmenu z-20, backdrop z-10, header z-10
---

<header
  class="bg-tuo-blue fixed z-10 flex w-full items-center justify-between text-base font-bold uppercase">
  <a href="/" class="mr-7.5 flex items-center py-2">
    <Image
      class="z-21 w-75"
      inferSize
      fetchpriority="high"
      decoding="async"
      src="https://opiskelijakunta.net/wp-content/uploads/2022/08/tuo-logo-min-2.png"
      alt="Turun ammattikorkeakoulun opiskelijakunta - TUO"
    />
  </a>

  <Navigation />
</header>
