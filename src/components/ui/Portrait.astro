---
import { Image } from "astro:assets";
import type { Person } from "@/lib/schemas";

interface Props {
  person: Person;
}

const { person } = Astro.props;
---

<div class="w-72">
  <div class="flex flex-col items-center text-center">
    <Image
      loading="lazy"
      decoding="async"
      src={person.image}
      alt={person.name}
      class="shadow-tuo-md m-4 rounded-full"
      inferSize
    />
    <h5 class="uppercase">{person.name}</h5>
    <h6 class="uppercase">{person.title}</h6>
    <p class="">{person.role}</p>
    <div>
      <p>
        <a class="text-tuo-dark-blue" href=`mailto:${person.email}` target="_blank" rel="noopener">
          {person.email}
        </a>
        <br />
        {person.phone}
      </p>
    </div>
  </div>
</div>
