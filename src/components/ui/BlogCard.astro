---
import { Image } from "astro:assets";
import { type CollectionEntry } from "astro:content";
import FormattedDate from "../FormattedDate.astro";

import FallbackImage from "@/assets/blog-placeholder-1.jpg";

type Props = CollectionEntry<"posts">;

const post = Astro.props;
---

<a
  href={`blog/${post.data.slug}`}
  class="shadow-tuo-dark-blue bg-tuo-blue m-4 overflow-hidden rounded-md text-white shadow-md transition-all duration-150 hover:-translate-y-0.5 hover:shadow-lg">
  <div class="grid grid-cols-1">
    <Image
      class="w-full object-cover"
      src={post.data.featuredImage ? post.data.featuredImage?.node.guid : FallbackImage.src}
      alt={post.data.featuredImage?.node.title}
      loading="lazy"
      inferSize={true}
    />
    <div class="grid grid-cols-1 gap-2 p-4">
      <h4 class="text-tuo-yellow text-xl">{post.data.title}</h4>
      <FormattedDate date={post.data.date} />
      <p class="line-clamp-3">{post.data.content}</p>
      <p class="text-tuo-yellow font-bold">Lue lisää</p>
    </div>
  </div>
</a>
