---
import { Image } from "astro:assets";
import { type CollectionEntry } from "astro:content";
import FormattedDate from "../FormattedDate.astro";

import FallbackImage from "@/assets/blog-placeholder-1.jpg";

type Props = CollectionEntry<"posts">;

const post = Astro.props;
---

<div
  class="shadow-tuo-lg bg-tuo-blue rounded-tuo hover:shadow-tuo-xl m-4 overflow-hidden text-white transition-all duration-150 hover:-translate-y-0.5">
  <div class="flex h-full flex-col">
    <Image
      class="w-full object-cover"
      src={post.data.featuredImage ? post.data.featuredImage?.node.guid : FallbackImage.src}
      alt={post.data.featuredImage?.node.title}
      loading="lazy"
      inferSize={true}
    />
    <div class="flex h-full flex-col justify-between gap-2 p-4">
      <h4 class="">{post.data.title}</h4>
      <FormattedDate date={post.data.date} />
      <div class="line-clamp-4" set:html={post.data.content} />
      <a href={`blog/${post.data.slug}`} class="text-tuo-yellow font-bold">Lue lisää</a>
    </div>
  </div>
</div>
