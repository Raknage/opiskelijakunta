---
import { Plus, Minus } from "@lucide/astro";

interface Props {
  /**Title of the collapsible */
  title: string;
  /** @param {string} group
   * Add group name for only one in the same group to be expanded at a time */
  group?: string;
}

const { title, group = "" } = Astro.props;
---

<details
  name={group}
  class="group rounded-tuo bg-tuo-blue grid w-full grid-rows-[auto_0fr] self-start overflow-hidden transition-[grid-template-rows] duration-300 ease-out open:grid-rows-[auto_1fr]">
  <summary
    class="text-tuo-yellow flex cursor-pointer list-none items-center justify-between p-4 font-semibold select-none hover:opacity-95 [&::-webkit-details-marker]:hidden">
    <h4 class="text-tuo-yellow m-0 text-base font-semibold">{title}</h4>

    <div
      class="text-tuo-blue ml-4 flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-white shadow-sm">
      <Plus class="h-5 w-5 group-open:hidden" />
      <Minus class="hidden h-5 w-5 group-open:block" />
    </div>
  </summary>

  <div class="overflow-hidden">
    <div
      class="border-tuo-yellow border-t p-4 text-sm leading-relaxed text-neutral-100 *:first:mt-0 *:last:mb-0">
      <slot />
    </div>
  </div>
</details>
