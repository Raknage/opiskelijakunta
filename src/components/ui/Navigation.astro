---
import { pageProps } from "@/schemas";
import { ChevronDown, X, Menu } from "@lucide/astro";

const matches = import.meta.glob(["@/pages/*.astro", "!**/index.astro"], { eager: true });
const allPages = Object.values(matches) as any[];
const navItems = allPages
  .map((page) => {
    return { ...pageProps.parse(page.props), url: page.url };
  })
  .filter((page) => page.visible === true)
  .sort((a, b) => a.navOrder - b.navOrder);
---

<nav class="hidden xl:flex">
  <ul class="flex items-center text-white">
    {
      navItems.map((page) => {
        const hasSubmenu = page.submenu && page.submenu.length > 0;

        return (
          <li class="group relative flex items-center py-6.5 pr-5">
            <a class="hover:text-tuo-yellow transition-colors" href={page.url}>
              {page.title}
            </a>

            {hasSubmenu && (
              <>
                <ChevronDown
                  size={20}
                  class="text-tuo-yellow ml-1 transition-transform duration-200 group-hover:rotate-180"
                />

                <ul class="bg-tuo-blue border-tuo-yellow shadow-tuo-dark-blue/50 pointer-events-none invisible absolute top-full left-0 z-30 min-w-50 rounded-b-sm border-t-2 py-2 opacity-0 shadow-xl transition-all duration-200 ease-out group-hover:pointer-events-auto group-hover:visible group-hover:opacity-100">
                  {page.submenu.map((subItem) => (
                    <li>
                      <a
                        class="hover:text-tuo-yellow hover:bg-tuo-dark-blue/20 block px-4 py-2.5 text-sm transition-colors"
                        href={"id" in subItem ? `${page.url}/${subItem.id}` : subItem.url}>
                        {subItem.label}
                      </a>
                    </li>
                  ))}
                </ul>
              </>
            )}
          </li>
        );
      })
    }
  </ul>
</nav>

<!-- Mobile nav -->

<input type="checkbox" id="mobile-menu-toggle" class="peer sr-only" />
<label
  for="mobile-menu-toggle"
  class="text-tuo-yellow fixed top-2 right-4 z-20 cursor-pointer peer-checked:hidden xl:hidden"
  aria-label="Open Menu">
  <Menu size={60} />
</label>
<label
  for="mobile-menu-toggle"
  class="text-tuo-yellow fixed top-2 right-4 z-20 hidden cursor-pointer peer-checked:block"
  aria-label="Close Menu">
  <X size={60} />
</label>

<nav
  class="bg-tuo-blue border-tuo-yellow fixed top-18.75 right-0 z-20 h-full translate-x-full border-t-2 transition-all duration-300 ease-out peer-checked:translate-x-0">
  <ul class="flex flex-col gap-3 text-white xl:hidden">
    {
      navItems.map((page) => {
        const hasSubmenu = page.submenu && page.submenu.length > 0;
        const submenuId = `submenu-${page.navOrder}`;

        return (
          <li class="hover:text-tuo-yellow hover:bg-tuo-dark-blue/10 grid w-full px-4">
            {hasSubmenu ? (
              <>
                <input type="checkbox" id={submenuId} class="peer sr-only" />

                <div class="hover:bg-tuo-dark-blue/10 flex items-center justify-between px-4 py-3 peer-checked:[&_svg]:rotate-180">
                  <a class="grow font-medium" href={page.url}>
                    {page.title}
                  </a>

                  <label
                    for={submenuId}
                    class="text-tuo-yellow cursor-pointer p-1"
                    aria-label={`Toggle ${page.title} Submenu`}>
                    <ChevronDown size={20} class="transition-transform duration-300" />
                  </label>
                </div>

                <ul class="max-h-0 overflow-hidden transition-all duration-300 ease-in-out peer-checked:max-h-96">
                  {page.submenu.map((subItem) => (
                    <li class="hover:text-tuo-yellow block px-8 py-2 text-sm text-gray-200">
                      <a href={"id" in subItem ? `${page.url}/${subItem.id}` : subItem.url}>
                        {subItem.label}
                      </a>
                    </li>
                  ))}
                </ul>
              </>
            ) : (
              <a
                class="hover:text-tuo-yellow hover:bg-tuo-dark-blue/10 block px-4 py-3 font-medium"
                href={page.url}>
                {page.title}
              </a>
            )}
          </li>
        );
      })
    }
  </ul>
</nav>

<label
  for="mobile-menu-toggle"
  class="bg-tuo-dark-blue/50 fixed inset-0 z-10 hidden peer-checked:block"
  aria-label="Close Menu Backdrop">
</label>
