---
import { Image } from "astro:assets";
import type { Partner } from "@/lib/schemas";

interface Props {
  partner: Partner;
}

const { partner } = Astro.props;
---

<div class="w-64">
  <a class="" href={partner.link} target="_blank" rel="noopener">
    <div class="">
      <div class="flex flex-col items-center">
        <Image
          loading="lazy"
          decoding="async"
          src={partner.image}
          alt={partner.name}
          class="rounded-full"
          inferSize
        />
        <h4 class="">{partner.name}</h4>
        <div>
          <p></p>
        </div>
      </div>
    </div>
  </a>
</div>
