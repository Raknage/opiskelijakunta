---
import SymbolRound from "@/components/ui/BlurbSymbol.astro";
import TUOButton from "@/components/ui/TUOButton.astro";

type Blurb = {
  symbol: "heart" | "star" | "users" | "handshake" | "shopping" | "coffee";
  heading: string;
  text: string;
  link: string;
  target?: "_blank" | "_self";
};

const blurbs = [
  {
    symbol: "heart",
    heading: "Opiskelijakunta",
    text: "Yhdessä parempaa opiskelijaelämää",
    link: "/opiskelijakunta",
  },
  {
    symbol: "star",
    heading: "Liity jäseneksi",
    text: "Tule osaksi yhteisöämme!",
    link: "/jasenyys",
  },
  {
    symbol: "coffee",
    heading: "TUO lounge",
    text: "Yhteisömme kohtaamispaikka",
    link: "/palvelut",
  },
  {
    symbol: "shopping",
    heading: "Verkkokauppa",
    text: "Osaksi yhteisöä kotisohvalta",
    link: "https://kide.app/community/b7ba5770-37be-47e6-bafa-d0dd10fc520e/products",
    target: "_blank",
  },
] as Blurb[];
---

<section
  class="border-tuo-yellow rounded-tuo shadow-tuo-md m-auto mt-[-10%] mb-8 w-fit max-w-9/10 border-t-18 bg-white tracking-wider">
  <div class="grid sm:grid-cols-2 lg:grid-cols-4">
    {
      blurbs.map((b) => {
        return (
          <div class="grid min-w-60 grid-rows-[auto_1fr_1fr_auto] place-items-center px-10 py-5 text-center lg:py-7.5">
            <SymbolRound icon={b.symbol} />
            <h4 class="pb-2.5 text-lg font-black uppercase">{b.heading}</h4>
            <p class="font-normal">{b.text}</p>
            <TUOButton link={b.link} text="Lue lisää" target={b.target} />
          </div>
        );
      })
    }
  </div>
</section>
