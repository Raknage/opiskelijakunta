  title: "Edunvalvonta",
  navOrder: 4,
  visible: true,
  path: "edunvalvonta",
  submenu: [
    { label: "Edunvalvonta", id: "#edunvalvonta" },
    { label: "Häirintäyhdyshenkilö", id: "#hairinta" },
    { label: "Opiskelijaedustajat", id: "#edustajat" },
    { label: "Aktiivit", id: "#aktiivit" },
    { label: "Johtoryhmävastaavat", id: "#johtoryhma" },
