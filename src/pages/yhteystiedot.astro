---
import type { PageProps } from "@/schemas";
import { Image } from "astro:assets";

export const props: PageProps = {
  title: "Yhteystiedot",
  navOrder: 6,
  visible: true,
  submenu: [
    { label: "Tuo Lounge", id: "#lounge" },
    { label: "Toimisto", id: "#henkilosto" },
    { label: "Meidän yhteystiedot", id: "#henkilosto" },
    { label: "Laskutustiedot", id: "#laskutus" },
    { label: "Anna palautetta", id: "#palaute" },
  ],
};
---

<article>
  <h1>Yhteystiedot</h1>

  <nav>
    <ul>
      <li>
        <a href="https://opiskelijakunta.net/yhteystiedot/#lounge" aria-current="page">
          Tuo Lounge
        </a>
      </li><li>
        <a href="https://opiskelijakunta.net/yhteystiedot/#toimisto" aria-current="page">
          Toimisto
        </a>
      </li><li>
        <a href="https://opiskelijakunta.net/yhteystiedot/#henkilosto" aria-current="page">
          Meidän yhteystiedot
        </a>
      </li><li>
        <a href="https://opiskelijakunta.net/yhteystiedot/#laskutus" aria-current="page">
          Laskutus
        </a>
      </li><li>
        <a href="https://opiskelijakunta.net/yhteystiedot/#palaute" aria-current="page">Palaute</a>
      </li>
    </ul>
  </nav>

  <ul>
    <li>
      <a href="https://opiskelijakunta.net/yhteystiedot/#lounge" aria-current="page">Tuo Lounge</a>
    </li><li>
      <a href="https://opiskelijakunta.net/yhteystiedot/#toimisto" aria-current="page">Toimisto</a>
    </li><li>
      <a href="https://opiskelijakunta.net/yhteystiedot/#henkilosto" aria-current="page">
        Meidän yhteystiedot
      </a>
    </li><li>
      <a href="https://opiskelijakunta.net/yhteystiedot/#laskutus" aria-current="page">Laskutus</a>
    </li><li>
      <a href="https://opiskelijakunta.net/yhteystiedot/#palaute" aria-current="page">Palaute</a>
    </li>
  </ul>

  <h3>TUO Lounge</h3>

  <p>Opiskelijakunta TUOn TUO Loungen löydät EduCityn 2. kerroksesta 2069 Kahvio -tilasta!</p><p>
    TUO Loungeen voit tulla pelaaman vaikka pleikkaria kiireisen päivän keskellä kavereiden kanssa
    tai ostamaan KampusKaupan tuotteita. TUO Loungesta saat myös lainattua pelivälineet esimerkiksi
    biljardiin ja pöytäfutikseen. TUO Loungesta saat myös apua jäsenyyteen liittyvissä asioissa,
    kuten opiskelijakortin käyttöönotosta.
  </p><p>TUO Lounge onauki lähtökohtaisesti viikon jokaisena arkipäivänä:</p><p>
    Ma klo 10-15<br />Ti klo 10-15<br />Ke klo 10-15<br />To klo 10-15<br />Pe klo 10-15
  </p><p>
    Julkaisemme joka viikko tarkat aukioloajat erikseen <a
      href="https://www.instagram.com/opiskelijakunta_tuo/?hl=fi"
      target="_blank"
      rel="noopener">
      Instagramissamme
    </a>!
  </p>

  <Image
    decoding="async"
    width="800"
    height="400"
    src="https://opiskelijakunta.net/wp-content/uploads/2022/10/Nimeton-suunn.malli-3-min.jpg"
    alt=""
    title="Nimetön suunn.malli (3)-min"
    srcset="https://opiskelijakunta.net/wp-content/uploads/2022/10/Nimeton-suunn.malli-3-min.jpg 800w, https://opiskelijakunta.net/wp-content/uploads/2022/10/Nimeton-suunn.malli-3-min-480x240.jpg 480w"
    sizes="(min-width: 0px) and (max-width: 480px) 480px, (min-width: 481px) 800px, 100vw"
  />

  <h3>Toimisto</h3>

  <p>
    Turun ammattikorkeakoulun opiskelijakunta – TUO<br />Joukahaisenkatu 7<br />20520 Turku
  </p><p>
    <strong>TUO Lounge:<br /></strong>EduCityn 2. kerros 2069 Kahvio -tila
  </p><p>
    <strong>S-posti: tuo@opiskelijakunta.net</strong><br /><em>
      Vastaamme sähköposteihin arkisin vuorokauden kuluessa.
    </em>
  </p>

  <h3>Meidän yhteystiedot</h3>

  <p>
    Kaikki toimijat voit tavoittaa <a href="mailto:etunimi.sukunimi@opiskelijakunta.net">
      tuo@opiskelijakunta.net
    </a>. Tarkemmat yhteystiedot löydät painikkeiden kautta.<br /><em></em>
  </p>

  <a href="https://opiskelijakunta.net/opiskelijakunta/#hallitus">Hallitus</a>

  <a href="https://opiskelijakunta.net/opiskelijakunta/#henkilokunta">Henkilöstö</a>

  <a href="https://opiskelijakunta.net/opiskelijakunta/#edustajisto">Edustajisto</a>

  <h3>Laskutusosoite</h3>

  <p>Y-Tunnus: 2045784-1</p><p>
    Verkkolaskuosoite:<br />OVT-tunnus: 003720457841<br />Operaattori: BasWare, BAWCFI22
  </p><p>Opiskelijakunta ottaa laskuja vastaan ainoastaan verkkolaskutuksen kautta.</p>

  <h3>Anna palautetta</h3><div
    data-form_unique_num="0"
    data-form_unique_id="69d1fd1d-a389-423f-aa9a-57f490c7b8c0">
    <form method="post" action="https://opiskelijakunta.net/yhteystiedot/">
      <p data-id="name" data-type="input">
        <label for="et_pb_contact_name_0">Nimi (ei pakollinen)</label>
        <input
          type="text"
          value=""
          name="et_pb_contact_name_0"
          data-required_mark="not_required"
          data-field_type="input"
          data-original_id="name"
          placeholder="Nimi (ei pakollinen)"
        />
      </p><p data-id="email" data-type="email">
        <label for="et_pb_contact_email_0">Sähköposti (ei pakollinen)</label>
        <input
          type="text"
          value=""
          name="et_pb_contact_email_0"
          data-required_mark="not_required"
          data-field_type="email"
          data-original_id="email"
          placeholder="Sähköposti (ei pakollinen)"
        />
      </p><p data-id="puhelin" data-type="input">
        <label for="et_pb_contact_puhelin_0">Puhelin (ei pakollinen)</label>
        <input
          type="text"
          value=""
          name="et_pb_contact_puhelin_0"
          data-required_mark="not_required"
          data-field_type="input"
          data-original_id="puhelin"
          placeholder="Puhelin (ei pakollinen)"
        />
      </p><p data-id="message" data-type="text">
        <label for="et_pb_contact_message_0">
          Vapaamuotoinen viesti (jätäthän yhteystietosi, jos haluat, että olemme sinuun yhteydessä)
        </label><textarea
          name="et_pb_contact_message_0"
          data-required_mark="required"
          data-field_type="text"
          data-original_id="message"
          placeholder="Vapaamuotoinen viesti (jätäthän yhteystietosi, jos haluat, että olemme sinuun yhteydessä)">
        </textarea>
      </p>
      <input type="hidden" value="et_contact_proccess" name="et_pb_contactform_submit_0" />

      <p>
        9 + 15 = <input
          type="text"
          size="2"
          data-first_digit="9"
          data-second_digit="15"
          value=""
          name="et_pb_contact_captcha_0"
          data-required_mark="required"
          autocomplete="off"
        />
      </p>

      <button type="submit" name="et_builder_submit_button">Lähetä</button>

      <input
        type="hidden"
        name="_wpnonce-et-pb-contact-form-submitted-0"
        value="0279728bda"
      /><input type="hidden" name="_wp_http_referer" value="/yhteystiedot/" />
    </form>
  </div>
</article>
