---
import Hero from "@/components/Hero.astro";
import Blurb from "@/components/Blurb.astro";
import Layout from "../layouts/Layout.astro";
import { Image } from "astro:assets";
---

<Layout>
  <main>
    <Hero title="Luomassa parempaa opiskelijaelämää" />
    <Blurb />
    <article>
      <Image
        loading="lazy"
        decoding="async"
        width="750"
        height="423"
        src="https://opiskelijakunta.net/wp-content/uploads/2025/05/Edustajistovaalit-2024-kotisivut-1.jpg"
        alt=""
        title="Edustajistovaalit 2024 kotisivut (1)"
        srcset="https://opiskelijakunta.net/wp-content/uploads/2025/05/Edustajistovaalit-2024-kotisivut-1.jpg 750w, https://opiskelijakunta.net/wp-content/uploads/2025/05/Edustajistovaalit-2024-kotisivut-1-480x271.jpg 480w"
        sizes="(min-width: 0px) and (max-width: 480px) 480px, (min-width: 481px) 750px, 100vw"
      />
      <article>
        <h2>
          <a
            href="https://opiskelijakunta.net/kannanotto-ei-kukaan-valmistu-nopeammin-koyhyydessa/">
            Kannanotto: Ei kukaan valmistu nopeammin köyhyydessä
          </a>
        </h2>
        <p>
          Opiskelijaliike on huutanut tätä. Opetus- ja kulttuuriministeriö on sanonut sen. Nyt myös
          Kela on todennut saman: opiskelijat eivät pärjää. Opintotuen taso ei vastaa todellisia
          elinkustannuksia, ja järjestelmä tarvitsee sekä...
        </p>
        <a href="https://opiskelijakunta.net/kannanotto-ei-kukaan-valmistu-nopeammin-koyhyydessa/">
          lue lisää
        </a>
      </article><article>
        <h2>
          <a
            href="https://opiskelijakunta.net/haku-turun-ammattikorkeakoulu-oyn-opiskelijaedustajaksi-on-auki-3/">
            Haku Turun ammattikorkeakoulu Oy:n opiskelijaedustajaksi on auki
          </a>
        </h2>
        <p>
          Turun ammattikorkeakoulun opiskelijakunta – TUOn keskusvaalilautakunta on avannut haun
          Turun ammattikorkeakoulun osakeyhtiön hallituksen opiskelijaedustajaksi.
          Opiskelijaedustajan luottamustoimi kestää yhden vuoden 1.6.2026&nbsp;–...
        </p>
        <a
          href="https://opiskelijakunta.net/haku-turun-ammattikorkeakoulu-oyn-opiskelijaedustajaksi-on-auki-3/">
          lue lisää
        </a>
      </article>
      <a href="https://opiskelijakunta.net/ajankohtaista/">Katso kaikki</a>
    </article>
  </main>
</Layout>
