---
import type { PageProps } from "@/schemas";
import HeroPages from "@/components/HeroPages.astro";
import HeroSection from "@/components/HeroSection.astro";
import PageNav from "@/components/PageNav.astro";
import Collapsible from "@/components/ui/Collapsible.astro";
import Layout from "@/layouts/Layout.astro";
import TUOButton from "@/components/ui/TUOButton.astro";

export const props: PageProps = {
  title: "Palvelut",
  navOrder: 5,
  visible: true,
  path: "palvelut",
  submenu: [
    { label: "Tuo Lounge", id: "#olohuone" },
    { label: "Tapahtumat", id: "#tapahtumat" },
    { label: "Lainaus", id: "#lainaus" },
    { label: "Oikeusapu", id: "#oikeusapu" },
  ],
};
---

<Layout>
  <main>
    <HeroPages title="Palvelut" />
    <PageNav {...props} />

    <HeroSection
      id="olohuone"
      title="Tuo Lounge"
      img="https://opiskelijakunta.net/wp-content/uploads/2022/10/Nimeton-suunn.malli-4-min.jpg">
      <p>
        Löydät TUO Loungen EduCityn toisesta kerroksesta 2069 Kahvio -tilasta. Loungeen voit tulla
        esimerkiksi luentojen välissä tai ruokatauolla pelaamaan biljardia, juomaan rauhassa kupin
        kuumaa tai&nbsp; vaikka haastamaan kaverin änärissä. TUO Loungesta löydät myös
        opiskelijakunnan henkilöstöä, jotka auttavat esimerkiksi opiskelun ongelmatilanteisiin ja
        jäsenyyteen liittyvissä asioissa.
      </p><p>
        TUO Loungesta voit ostaa erilaisia TUOlaiselle sopivia TUOtteita, kuten haalarimerkkejä,
        shottilaseja ja juomapulloja. Voit myös ostaa Turku AMK hupparin, collegen tai t-paidan
        Loungesta. Turku AMK brändituotteet myös myynnissä
        <a href="https://go.innoflame.fi/goshop/TUO" target="_blank" rel="noopener">
          verkkokaupasta
        </a>.&nbsp;
      </p><p>
        TUO Loungessa kannattaa tulla piipahtamaan, voit yllättyä erilaisista alennuksista sekä
        kampanjoista!
      </p>

      <TUOButton link="/yhteystiedot/#lounge" text="Aukioloajat" />
    </HeroSection>

    <HeroSection
      id="tapahtumat"
      title="Tapahtumat"
      img="https://opiskelijakunta.net/wp-content/uploads/2022/10/Nimeton-suunn.malli-6-min.jpg"
      reverse>
      <p>
        Opiskelijakunta TUO järjestää vuosittain lukusia erilaisia opiskelijatapahtumia. Muun muassa
        legendaariset Keltanokkabileet syksyisin, johon osallistuu yli 1000 opiskelijaa. Keväällä
        lähdetään esimerkiksi Landerundilla Turun lähikuntiin busseilla.
      </p><p>
        Opiskelijakunnan jäsenet pääsevät kaikkiin TUOn tapahtumiin alennettuun hintaan. Lisäksi
        jäseniä pyritään huomioimaan erilaisilla tavoilla tapahtumissa.
      </p><p>
        TUOn jäsenenä saat myös alennusta OPKU+ tapahtumista useista kaupungeista. Kannattaa siis
        katsoa mitä tapahtumia esimerkiksi pääkaupunkiseudulta tai Jyväskylästä löytyy.
      </p><p>Tapahtumiin liittyvissä kysymyksissä ota yhteyttä tapahtumat@opiskelijakunta.net</p>

      <TUOButton link="/ajankohtaista/#kalenteri" text="Katso tapahtumakalenteri" />
    </HeroSection>

    <HeroSection
      id="lainaus"
      title="Lainauspalvelu"
      img="https://opiskelijakunta.net/wp-content/uploads/2022/10/Nimeton-suunn.malli-121-min.jpg">
      <p>
        Opiskelijakunta TUOlta, on mahdollisuus opiskelijoiden lainata erilaisia tarvikkeita esim.
        illan viettoihin tai opiskelijaelämän tilanteisiin. Lainattavana on esimerkiksi lauta- ja
        ulkopelejä, termareita, kahvinkeitin, vedenkeitin ja vaikka mitä muuta.
      </p><p>
        Voit tiedustella lainattavia tarvikkeita osoitteesta tuo@opiskelijakunta.net. Lainattavat
        tarvikkeet noudetaan TUO Loungesta ja palautetaan sinne. Voit myös vinkata meille uusia
        lainattavia tuotteita samaan osoitteeseen.
      </p>
    </HeroSection>

    <section id="oikeusapu" class="">
      <HeroSection reverse title="OIKEUSAPU JA NEUVONTA">
        <p>
          Mietityttääkö sinua jokin oikeudellinen ongelma, esimerkiksi vuokra- tai työsuhteen
          solmimisen tai irtisanomisen suhteen? Pohditko perintöön tai avo- tai avioliittoon
          liittyviä oikeudellisia asioita? Onko sinulla riitaa jostain laskusta? Mietitkö yrityksen
          perustamiseen tai kenties ainejärjestöjen yhdistyssääntöihin liittyviä kysymyksiä?
          Askarruttaako sinua jokin muu oikeudellinen ongelma?
        </p><p>
          Turun yliopiston oikeustieteellisen tiedekunnan ainejärjestö Lex ry:n ylläpitämä
          oikeusapujaosto tarjoaa maksutonta lakineuvontaa kaikille Turun yliopiston
          ylioppilaskunnan, Åbo Akademis Studentkårin sekä opiskelijakunta TUOn jäsenille ympäri
          vuoden. Oikeusapujaosto tarjoaa apua nyt myös rikosasioissa.
        </p><p>
          Oikeusapujaosto koostuu oikeustieteen opiskelijoista. Oikeusapujaosto on sitoutunut
          auttamaan kaikkia opiskelijoita parhaalla mahdollisella tavalla – parhaan kykynsä ja
          ammattitaitonsa mukaan.
        </p>
        <div slot="left" class="flex flex-col gap-4">
          <Collapsible group="" title="Kuinka Jaostoon voi ottaa yhteyttä">
            <p>• Tulemalla päivystysaikana paikan päälle (Rehtorinpellonkatu 4 A)</p><p>
              • Soittamalla päivystysaikana numeroon +358 45 843 3428, tai
            </p><p>• Lähettämällä sähköpostia osoitteeseen: tyy-oikeusapu@utu.fi.</p>
          </Collapsible>
          <Collapsible group="" title="Mitä tulee ilmoittaa?">
            <p>
              Kaikki tapaukset ja asiakastiedot ovat luottamuksellisia. Ottaessasi yhteyttä
              jaostoon, listaa ylös asiasi tiedot mahdollisimman yksityiskohtaisesti: mitä
              tarkalleen on tapahtunut ja milloin ja mikä asiassa mietityttää. Huomaathan myös,
              ettei oikeusapujaosto anna rikos- tai vero-oikeudellista neuvontaa eikä laadi
              asiakirjoja edes välillisesti.
            </p>
          </Collapsible>
          <Collapsible group="" title="Missä jaosto päivystää?">
            <p>
              Jaosto päivystää&nbsp;TYYn toimiston viereisessä kokoustila Virtasessa aina
              keskiviikkoisin klo 18-20. Jaosto palvelee suomen, ruotsin ja englannin kielellä.
              Jaosto jää lomalle 17.12. päivän päivystyksen jälkeen.&nbsp;
            </p>
          </Collapsible>
          <Collapsible group="" title="Miten saan palvelun käyttööni?">
            <p>
              Varauduthan &nbsp;todistamaan opiskelijaoikeutesi esimerkiksi opiskelijakortilla tai
              lähettämällä sähköpostiviestisi koulun sähköpostistasi, jotta oikeutesi palveluun
              voidaan varmentaa.&nbsp;
            </p>
          </Collapsible>
        </div>
      </HeroSection>
    </section>
  </main>
</Layout>
